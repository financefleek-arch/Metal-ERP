{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "ShopApiKey": "REPLACE_WITH_SHOP_API_KEY",
    "BackendBaseUrl": "https://metalerp.fleek.example.com",
    "StateDbPath": "C:\\ProgramData\\TallyAgent\\state.db",
    "LogDirectory": "C:\\ProgramData\\TallyAgent\\logs",
    "BackupSync": {
      "Enabled": true,
      "WatchFolder": "C:\\REPLACE\\Tally\\Backup",
      "FilePattern": "*",
      "PollIntervalMinutes": 5,
      "LocalRetentionCount": 7
    },
    "BackupHealthMonitor": {
      "Enabled": true,
      "PollIntervalMinutes": 15,
      "ExpectedIntervalHours": 26
    },
    "WhatsAppDelivery": {
      "Enabled": false,
      "PollIntervalMinutes": 5,
      "TallyGatewayBaseUrl": "http://localhost:9000"
    }
  }
}
