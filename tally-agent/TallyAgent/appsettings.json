{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "ShopApiKey": "REPLACE_WITH_SHOP_API_KEY",
    "BackendBaseUrl": "https://metalerp.fleek.example.com",
    "StateDbPath": "%LOCALAPPDATA%\\TallyAgent\\state.db",
    "LogDirectory": "%LOCALAPPDATA%\\TallyAgent\\logs",
    "BackupSync": {
      "Enabled": true,
      "WatchFolder": "C:\\Tally\\Backup",
      "FilePatterns": ["TDBK*", "TBK*.900"],
      "PollIntervalMinutes": 5,
      "LocalRetentionCount": 7
    },
    "BackupHealthMonitor": {
      "Enabled": true,
      "PollIntervalMinutes": 15,
      "ExpectedIntervalHours": 26
    },
    "WhatsAppDelivery": {
      "Enabled": false,
      "PollIntervalMinutes": 5,
      "TallyGatewayBaseUrl": "http://127.0.0.1:9000"
    }
  }
}
