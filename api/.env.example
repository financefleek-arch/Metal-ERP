# Copy to .env for local development. NEVER commit a real .env.
# In production these are passed by docker-compose.yml (infra repo), not
# from a file.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://metalerp:metalerp@localhost:5432/metalerp
BASE_URL=http://localhost:8000

JWT_SECRET=dev-insecure-change-me
PDF_DIR=./_pdfs

# Optional
# SMTP_URL=smtp://user:pass@smtp-relay.brevo.com:587
# SENTRY_DSN=

# Only needed when running `python -m app.seed` to create the first
# tenant + admin (otherwise seed loads reference data only):
# SEED_TENANT_NAME=Sethia Metal Store
# SEED_ADMIN_EMAIL=owner@example.com
# SEED_ADMIN_PASSWORD=change-me
